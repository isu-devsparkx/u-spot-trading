# ─── U-SPOT Environment Configuration ────────────────────────────────
# Copy this file to .env.local and populate the values below

# ── Application Configuration ──────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=U-SPOT
NEXT_PUBLIC_APP_VERSION=0.1.0

# ── Binance Spot API (Free Public Tier - Zero Keys Needed) ─────────────
NEXT_PUBLIC_BINANCE_API_URL=https://api.binance.com/api/v3
NEXT_PUBLIC_BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# ── Supabase PostgreSQL Database (Free Tier) ───────────────────────────
# Obtain these from your Supabase Project Settings -> API:
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Telegram Bot Notifications (100% Free) ────────────────────────────
# 1. Create a bot with @BotFather on Telegram to get your bot token
# 2. Get your Chat ID by messaging @userinfobot or adding your bot to a channel
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# ── Google Gemini AI (100% Free Tier API Key) ─────────────────────────
# Obtain free key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── 24/7 Autonomous Cron Engine & Deployment URL ──────────────────────
# URL of your live deployment (e.g. https://your-u-spot.vercel.app or http://localhost:3000)
BASE_URL=http://localhost:3000
# Secret for securing internal worker/cron endpoints (/api/signals/lifecycle, etc.)
CRON_SECRET=your_random_cron_secret_here

# ── Session & Cryptographic Authentication Secret ─────────────────────
# 32+ character random secret used for signing HttpOnly session cookies
AUTH_SECRET=your_32_character_random_auth_secret_here


